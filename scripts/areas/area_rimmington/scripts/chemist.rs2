[oplocu,lamp_oil_still]
def_obj $useitem = last_useitem;

if(last_useitem = swamp_tar) {
    if(testbit(%goblin_caves, 5) = ^true) {
        mes("There's already oil in the still"); // TODO: Real message
        return;
    }

    inv_del(inv, swamp_tar, 1);
    %goblin_caves = setbit(%goblin_caves, 5);
    mes("You fill the still with swamp tar..."); // TODO: Real message
} else if(last_useitem = tog_sapphire_lantern_empty) {
    if(testbit(%goblin_caves, 5) = ^false) {
        mes("There is no oil in the still for you to use..."); // TODO: Real message
        return;
    }

    inv_del(inv, tog_sapphire_lantern_empty, 1);
    inv_add(inv, tog_sapphire_lantern_unlit, 1);
    mes("You fill your lantern with oil..."); // TODO: Real message
    %goblin_caves = clearbit(%goblin_caves, 5);
} else {
    mes("Nothing interesting happens.");
}

